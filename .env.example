# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---- Required --------------------------------------------------------
DISCORD_TOKEN=

# ---- Guild allowlist -------------------------------------------------
# Comma-separated guild IDs allowed to use the bot.
# Example: 123456789012345678,987654321098765432
ALLOWED_GUILD_IDS=

# ---- Sync mode -------------------------------------------------------
# Use 'guild' locally so commands appear instantly in your test server.
# Use 'global' on the cloud host so commands work across all servers.
COMMAND_SYNC_MODE=local

# Required only when COMMAND_SYNC_MODE=guild.
# Right-click your server name in Discord -> Copy Server ID.
DISCORD_GUILD_ID=

# ---- Audit logging ---------------------------------------------------
# Optional but recommended: private Discord webhook URL for security/audit logs.
AUDIT_WEBHOOK_URL=